{
  "name": "panel-ui",
  "version": "0.2.0",
  "description": "Industrial control-panel UI components for the web.",
  "author": "akkbar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akkbar/panel-ui.git"
  },
  "homepage": "https://github.com/akkbar/panel-ui#readme",
  "bugs": {
    "url": "https://github.com/akkbar/panel-ui/issues"
  },
  "keywords": [
    "control-panel",
    "industrial-ui",
    "hmi",
    "scada",
    "ui-components",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": ["./style.css"],
  "files": ["dist", "style.css", "README.md", "CHANGELOG.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./vue": {
      "types": "./dist/vue.d.ts",
      "import": "./dist/vue.js"
    },
    "./svelte": {
      "types": "./dist/svelte.d.ts",
      "import": "./dist/svelte.js"
    },
    "./web-components": {
      "types": "./dist/web-components.d.ts",
      "import": "./dist/web-components.js"
    },
    "./style.css": "./style.css"
  },
  "scripts": {
    "dev": "vite --open demo/index.html",
    "build": "vite build && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.12",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.2",
    "react": "^19.1.1",
    "vite": "^7.1.5",
    "vitest": "^4.1.11",
    "vue": "^3.5.21"
  },
  "peerDependencies": {
    "react": ">=18 <20",
    "vue": ">=3.4 <4"
  },
  "peerDependenciesMeta": {
    "react": { "optional": true },
    "vue": { "optional": true }
  }
}

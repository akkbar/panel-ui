{
  "name": "panel-ui",
  "version": "0.1.0",
  "description": "Industrial control-panel UI components for the web.",
  "author": "akkbar",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akkbar/panel-ui.git"
  },
  "homepage": "https://github.com/akkbar/panel-ui#readme",
  "bugs": {
    "url": "https://github.com/akkbar/panel-ui/issues"
  },
  "keywords": [
    "control-panel",
    "industrial-ui",
    "hmi",
    "scada",
    "ui-components",
    "typescript"
  ],
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": ["./style.css"],
  "files": ["dist", "style.css", "README.md", "CHANGELOG.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./style.css"
  },
  "scripts": {
    "dev": "vite --open demo/index.html",
    "build": "vite build && tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit && vitest run",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "happy-dom": "^20.14.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vitest": "^4.1.11"
  }
}
